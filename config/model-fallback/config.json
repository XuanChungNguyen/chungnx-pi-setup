{
  "version": 1,
  "enabled": true,
  "autoRetry": true,
  "rules": [
    {
      "name": "codex-to-anthropic-sonnet",
      "matchProviders": ["openai-codex"],
      "statuses": [429, 500, 502, 503, 504],
      "cooldownMs": 18000000,
      "fallback": {
        "provider": "anthropic",
        "model": "claude-sonnet-5"
      }
    }
  ]
}
